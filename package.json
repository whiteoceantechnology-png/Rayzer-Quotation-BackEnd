{
  "name": "rayzer-quotation-backend",
  "description": "Backend service for Rayzer Quotation system",
  "version": "1.0.0",
  "author": "White Ocean Technology",
  "type": "module",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">= 18.17",
    "npm": ">= 9.0.0",
    "yarn": ">=1.22.0"
  },
  "main": "./src/index.js",
  "keywords": [
    "express",
    "es6",
    "es7",
    "rest",
    "api",
    "boilerplate",
    "mongodb",
    "node",
    "javascript",
    "pm2",
    "babel",
    "nps",
    "commitizen",
    "semantic-release",
    "prettier",
    "lint-staged",
    "webpack2"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/**/*.js": [
      "yarn prettier",
      "git add"
    ]
  },
  "scripts": {
    "build": "nps build",
    "start": "nps",
    "test": "nps test",
    "test:watch": "nps test.watch",
    "dev": "nodemon ./src/index.js",
    "dev:debug": "nps dev.debug",
    "prettier": "prettier --write '{src,__{tests,mocks}__}/**/*.js'",
    "precommit": "nps lintStaged && nps validate",
    "checkCover": "nps test.checkCover",
    "cover": "nps test.cover",
    "db:seeds-user": "nps db.seedsUser",
    "db:seeds-clear": "nps db.seedsClearUser",
    "db:seeds-clear-user": "nps db.seedsClear",
    "lint": "nps lint",
    "lint:fix": "nps lint.fix",
    "reportCoverage": "nps reportCoverage",
    "doc": "nps doc",
    "doc:deploy": "nps doc.deploy",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "devDependencies": {
    "ajv": "^6.0.0",
    "ajv-keywords": "^3.0.0",
    "all-contributors-cli": "^3.1.1",
    "babel-cli": "^6.26.0",
    "babel-loader": "^7.1.2",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-preset-env": "^0.0.0",
    "babel-register": "^6.26.0",
    "chai": "^4.1.1",
    "coveralls": "^3.0.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^2.3.0",
    "exceljs": "^4.4.0",
    "faker": "^4.1.0",
    "husky": "^0.14.3",
    "istanbul": "^0.4.5",
    "lint-staged": "^16.2.5",
    "mocha": "^5.0.2",
    "multer": "^2.0.2",
    "nodemon": "^2.0.0",
    "nps": "^5.7.1",
    "nps-utils": "^1.0.2",
    "pdfkit": "^0.17.2",
    "pino-pretty": "^11.2.0",
    "prettier": "^1.6.1",
    "semantic-release": "^24.2.9",
    "source-list-map": "2.0.0",
    "superagent": "^3.6.0",
    "supertest": "^3.0.0",
    "webpack": "^5.102.1",
    "webpack-node-externals": "^1.6.0",
    "webpack-sources": "1.0.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.0",
    "cors": "^2.8.4",
    "dotenv": "^5.0.0",
    "express": "^4.15.4",
    "express-rate-limit": "^8.2.1",
    "express-status-monitor": "^1.0.0",
    "express-validation": "^1.0.2",
    "helmet": "^3.8.1",
    "http-status": "^1.0.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^2.3.8",
    "mongoose": "^8.19.2",
    "mongoose-unique-validator": "^4.0.1",
    "node-cache": "^5.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.1.0",
    "pm2": "^6.0.13",
    "slug": "^0.9.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}